# Cloudflare _headers: a BLANK LINE ends a rule block, so every header for a
# path must sit in one unbroken group (comments are fine, blank lines are not).
# Always revalidate with the edge so deploys show up immediately.
/*
  Cache-Control: no-cache
  # Don't let browsers guess content types (MIME sniffing).
  X-Content-Type-Options: nosniff
  # Force HTTPS for a year, including subdomains (covers., analytics.).
  # Add "; preload" and submit to hstspreload.org once you're confident.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Only send the origin (not the full path) when navigating cross-site.
  Referrer-Policy: strict-origin-when-cross-origin
  # Clickjacking protection (CSP frame-ancestors below is the modern equivalent).
  X-Frame-Options: SAMEORIGIN
  # Camera is same-origin only for the /scan field-test page; every use still requires a browser permission prompt.
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), browsing-topics=()
  # Content Security Policy — REPORT-ONLY: logs violations to the console, blocks nothing.
  # To enforce, rename this header to "Content-Security-Policy". 'unsafe-inline' is
  # required by the inline scripts/styles/handlers; the rest is a tight host allow-list.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://analytics.smuthub.ca https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://kufpvbmwrtcciamdomhp.supabase.co wss://kufpvbmwrtcciamdomhp.supabase.co https://analytics.smuthub.ca https://static.cloudflareinsights.com https://www.googleapis.com https://openlibrary.org https://covers.openlibrary.org https://api.web3forms.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
